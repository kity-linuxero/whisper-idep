# Puerto interno de la app y direccion/puerto donde exponerla en el host.
# En produccion BIND_HOST suele ser la IP del LXC/servidor (no 0.0.0.0), para
# que solo el reverse proxy interno (npm, nginx, etc.) pueda llegar al puerto.
PORT=3000
BIND_HOST=127.0.0.1

# Rutas dentro del contenedor (normalmente no hace falta tocarlas).
DB_PATH=/app/data/jobs.db
UPLOADS_DIR=/app/uploads

# Host/usuario/clave SSH del motor de transcripcion (whisper.cpp + GPU).
# Ver README.md para como generar el usuario restringido y la clave SSH.
CT110_HOST=192.0.2.10
SSH_USER=whisperjobs
SSH_KEY_PATH=/app/secrets/id_ed25519
KNOWN_HOSTS_PATH=/app/secrets/known_hosts

# Limites de subida y de duracion maxima de un trabajo.
MAX_UPLOAD_MB=2048
MAX_JOB_MINUTES=90
